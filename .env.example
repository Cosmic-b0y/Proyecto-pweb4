# Configuración del entorno
# Copiar a .env y modificar según necesidad

# Aplicación
APP_NAME=Microservicios API
APP_VERSION=1.0.0
DEBUG=true

# API
API_PREFIX=/api
API_V1_PREFIX=/api/v1
API_V2_PREFIX=/api/v2

# Base de datos MySQL
DATABASE_URL=mysql+aiomysql://root:root@localhost:3306/proyecto_pweb4

# Base de datos PostgreSQL
DATABASE_PG_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/proyecto_pweb4_mecanico

# RabbitMQ
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# Seguridad / JWT
SECRET_KEY=tu-clave-secreta-aqui-cambiar-en-produccion
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS
ALLOWED_ORIGINS=*
